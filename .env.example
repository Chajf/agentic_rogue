# Copy to .env and adjust for your local installation.
POSTGRES_DB=agentic_rogue
POSTGRES_USER=rogue_runner
POSTGRES_PASSWORD=change-me

# OpenAI-compatible chat-completions endpoint, for example llama-server.
MODEL_BASE_URL=http://host.docker.internal:8080/v1
MODEL_NAME=local-model
MODEL_API_KEY=local

# Leave empty for a random Rogue seed.
GAME_SEED=
MAX_GAME_ACTIONS=10000
MAX_MODEL_CALLS_PER_ACTION=3
MODEL_TIMEOUT_SECONDS=120
ROGUE_TIMEOUT_SECONDS=10
CONTEXT_TOKEN_BUDGET=8192
