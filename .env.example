# Copy to .env and adjust for your local installation.
POSTGRES_DB=agentic_rogue
POSTGRES_USER=rogue_runner
POSTGRES_PASSWORD=change-me

# OpenAI-compatible chat-completions endpoint, for example llama-server.
MODEL_BASE_URL=http://host.docker.internal:8080/v1
MODEL_NAME=local-model
MODEL_API_KEY=local
# JSON kwargs for init_chat_model; override defaults. Set the model with MODEL_NAME.
# Example: MODEL_KWARGS='{"temperature":0.7,"max_tokens":2048,"extra_body":{"top_k":40}}'
MODEL_KWARGS='{}'

# Leave empty for a random Rogue seed.
GAME_SEED=
MAX_GAME_ACTIONS=10000
MAX_MODEL_CALLS_PER_ACTION=3
MODEL_TIMEOUT_SECONDS=120
ROGUE_TIMEOUT_SECONDS=10
CONTEXT_TOKEN_BUDGET=8192
# Maximum number of completed interactions in recent replay.
HISTORY_RECENT_INTERACTIONS=8
CONTEXT_POLICY=history_only
# Use legacy or rules-v2 for the standalone actor prompt.
PROMPT_PROFILE=legacy
# Set map-v1 with rules-v2 to enable observed working state.
STRUCTURED_STATE=off
# Set compact with map-v1 to render recent action effects.
HISTORY_FORMAT=replay
# Set managed-v1 with map-v1 to enable model-selected goals.
GOAL_MANAGEMENT=off
SUMMARY_CONTEXT_TOKEN_BUDGET=8192
SUMMARY_OUTPUT_TOKENS=1024
MAX_SUMMARY_ATTEMPTS=2
